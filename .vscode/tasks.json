{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fe",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontEnd"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting",
          "endsPattern": "successfully|listening|started"
        }
      }
    },
    {
      "label": "be",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backEnd"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting",
          "endsPattern": "successfully|listening|started"
        }
      }
    },
    {
      "label": "start-all",
      "dependsOn": [
        "be",
        "fe"
      ],
      "dependsOrder": "parallel"
    }
  ]
}