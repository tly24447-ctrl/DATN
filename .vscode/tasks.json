{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fe",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontEnd"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting",
          "endsPattern": "successfully|listening|started"
        }
      }
    },
    {
      "label": "be",
      "type": "shell",
      "command": "nest start --watch",
      "options": {
        "cwd": "${workspaceFolder}/backEnd"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting",
          "endsPattern": "successfully|listening|started"
        }
      }
    },
    {
      "label": "startMongo",
      "type": "shell",
      "command": "& 'C:/Program Files/MongoDB/Server/8.2/bin/mongod.exe' --port 27017 --dbpath 'C:/data/db' --replSet rs0",
      "options": {
        "cwd": "${workspaceFolder}/backEnd"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting",
          "endsPattern": "successfully|listening|started"
        }
      }
    },
    {
      "label": "start-all",
      "dependsOn": [
        "startMongo",
        "be",
        "fe"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "Configure Git Global",
      "type": "shell",
      "command": "git config --global user.name 'NNN'; git config --global user.email 'tly24447@gmail.com'",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
    },
    {
      "label": "push force",
      "type": "shell",
      "command": "git push origin main --force",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
    }
  ]
}